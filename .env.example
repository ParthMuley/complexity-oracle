# Complexity Oracle — environment variable reference
# Copy to .env for local development (gitignored).
# For permanent local config, run:  oracle setup

# ── Required for AI agent ──────────────────────────────────────────────────────
# Your Anthropic API key.
# Local:       set via `oracle setup` (saved to ~/.complexity_oracle/.env)
# Railway:     set in Railway dashboard (server pays for all requests)
# Cloud Run:   intentionally left unset → callers supply X-Anthropic-API-Key header
ANTHROPIC_API_KEY=sk-ant-...

# ── Cloud deployment ───────────────────────────────────────────────────────────
# Set to any non-empty value to disable subprocess profiling.
# Profiling runs arbitrary user code — never enable on a public endpoint.
# CLOUD_MODE=true

# ── Rate limiting ──────────────────────────────────────────────────────────────
# Per-IP request rate limit. Uses limits library format: "N/period"
# Examples: "10/minute", "100/hour", "1/second"
# Defaults: CLOUD_MODE=true → 10/minute | local → 1000/minute (effectively unlimited)
# RATE_LIMIT=10/minute
